# Voice AI Assistant & Auth Server Configuration (Port 3002)
PORT=3002
BASE_URL=http://localhost:3002
NODE_ENV=development

# Allowed CORS Origins (comma-separated URLs for your Vercel deployments)
# ALLOWED_ORIGINS=https://restroiq.vercel.app,https://restroiq-admin.vercel.app

# MongoDB Connection String (must point to the same database as backend)
MONGO_URI=mongodb://127.0.0.1:27017/restroiq

# JWT Authentication Secret
JWT_SECRET=restroiq_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d

# HuggingFace API Key (Meta-LLaMA 3 70B for Order Parsing & Menu Q&A)
HF_API_KEY=your_huggingface_api_key_here

# Sarvam AI API Key (Text-to-Speech: bulbul:v3, Indian English)
SARVAM_API_KEY=your_sarvam_api_key_here

# Gmail SMTP Email Configuration (Nodemailer for verification & order emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
