# Backend REST API Configuration (Port 3001)
PORT=3001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI in production)
MONGO_URL=mongodb://127.0.0.1:27017/restroiq

# Allowed CORS Origins (comma-separated URLs for your Vercel deployments)
# ALLOWED_ORIGINS=https://restroiq.vercel.app,https://restroiq-admin.vercel.app
